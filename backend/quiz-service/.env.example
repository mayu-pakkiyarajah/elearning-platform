SERVER_PORT=8084

DB_HOST=localhost
DB_PORT=3306
DB_NAME=quiz_db
DB_USER=quiz_user
DB_PASSWORD=quiz_pass

# MUST match auth-service's JWT_SECRET — this service only verifies tokens.
JWT_SECRET=change-this-to-a-long-random-base64-secret-in-production-min-256-bits

CORS_ORIGINS=http://localhost:4200

COURSE_SERVICE_URL=http://localhost:8082
ENROLLMENT_SERVICE_URL=http://localhost:8083
