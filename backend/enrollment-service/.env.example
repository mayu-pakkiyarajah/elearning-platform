SERVER_PORT=8083

DB_HOST=localhost
DB_PORT=3306
DB_NAME=enrollment_db
DB_USER=enrollment_user
DB_PASSWORD=enrollment_pass

# MUST match auth-service's JWT_SECRET — this service only verifies tokens.
JWT_SECRET=change-this-to-a-long-random-base64-secret-in-production-min-256-bits

CORS_ORIGINS=http://localhost:4200

# Where to reach course-service for course validation + lesson counts.
COURSE_SERVICE_URL=http://localhost:8082
