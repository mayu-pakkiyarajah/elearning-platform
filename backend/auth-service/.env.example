SERVER_PORT=8081

DB_HOST=localhost
DB_PORT=3306
DB_NAME=auth_db
DB_USER=auth_user
DB_PASSWORD=auth_pass

# Generate a real one with: openssl rand -base64 64
JWT_SECRET=change-this-to-a-long-random-base64-secret-in-production-min-256-bits
JWT_ACCESS_EXP_MS=900000
JWT_REFRESH_EXP_MS=604800000

RESET_TOKEN_EXP_MIN=30

CORS_ORIGINS=http://localhost:4200
