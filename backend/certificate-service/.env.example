SERVER_PORT=8085

DB_HOST=localhost
DB_PORT=3306
DB_NAME=certificate_db
DB_USER=certificate_user
DB_PASSWORD=certificate_pass

# MUST match auth-service's JWT_SECRET — this service only verifies tokens.
JWT_SECRET=change-this-to-a-long-random-base64-secret-in-production-min-256-bits

CORS_ORIGINS=http://localhost:4200

AUTH_SERVICE_URL=http://localhost:8081
ENROLLMENT_SERVICE_URL=http://localhost:8083

# used to build the public "share this certificate" link
FRONTEND_URL=http://localhost:4200
